---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  updated={post.data.updated}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  tags={post.data.tags}
>
  {post.data.youtube && (
    <div
      class="not-prose mx-auto mb-8 overflow-hidden rounded-lg shadow-lg"
      style={post.data.youtubeVertical
        ? 'max-width:360px;aspect-ratio:9/16'
        : 'max-width:100%;aspect-ratio:16/9'}
    >
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${post.data.youtube}?rel=0`}
        title={post.data.title}
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        style="width:100%;height:100%;border:0"
      ></iframe>
    </div>
  )}
  <Content />
</BlogPost>

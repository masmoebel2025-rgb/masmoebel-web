---
const year = new Date().getFullYear();
---

<footer class="text-white py-16" style="background: linear-gradient(180deg, rgba(249, 115, 22, 0.95) 0%, rgba(239, 68, 68, 0.95) 100%);">
	<div style="max-width: 1280px; margin: 0 auto; padding: 0 1rem;">
		<div class="grid grid-cols-2 md:grid-cols-4 gap-10 text-sm">
			<div>
				<span class="text-2xl font-bold tracking-tight">mas<span class="font-black">moebel</span></span>
				<p class="mt-3 text-orange-100 text-sm">Muebles Domínguez García 2.0 SL</p>
			</div>
			<div>
				<h4 class="font-semibold text-sm text-orange-100 mb-4 uppercase tracking-wider">Navegación</h4>
				<ul class="space-y-2.5">
					<li><a href="/" class="text-white/80 hover:text-white transition-colors duration-200">Inicio</a></li>
					<li><a href="/cocinas" class="text-white/80 hover:text-white transition-colors duration-200">Cocinas</a></li>
					<li><a href="/nosotros" class="text-white/80 hover:text-white transition-colors duration-200">Nosotros</a></li>
					<li><a href="/blog" class="text-white/80 hover:text-white transition-colors duration-200">Blog</a></li>
					<li><a href="/contacto" class="text-white/80 hover:text-white transition-colors duration-200">Contacto</a></li>
					<li><a href="https://mia.masmoebel.es" class="text-white/80 hover:text-white transition-colors duration-200">Mía · nuestra asistente de IA</a></li>
					<li><a href="https://planobras.es" class="text-white/80 hover:text-white transition-colors duration-200">Planobras · nuestra app para medir obra</a></li>
					<li><a href="https://oficios.masmoebel.es/" class="text-white/80 hover:text-white transition-colors duration-200">Oficios · presupuestos a voz para autónomos</a></li>
				</ul>
			</div>
			<div>
				<h4 class="font-semibold text-sm text-orange-100 mb-4 uppercase tracking-wider">Legal</h4>
				<ul class="space-y-2.5 text-white/80 text-sm">
					<li><a href="/aviso-legal" class="hover:text-white transition-colors duration-200">Aviso Legal</a></li>
					<li><a href="/privacidad" class="hover:text-white transition-colors duration-200">Privacidad</a></li>
					<li><a href="/cookies" class="hover:text-white transition-colors duration-200">Cookies</a></li>
				</ul>
			</div>
			<div>
				<h4 class="font-semibold text-sm text-orange-100 mb-4 uppercase tracking-wider">Contacto</h4>
				<ul class="space-y-2.5 text-white/80 text-sm">
					<li>+34 959 73 31 21</li>
					<li>WhatsApp: +34 692 68 61 48</li>
					<li>info@masmoebel.es</li>
					<li>Plaza Cruces de Mayo 3<br/>21830 Bonares, Huelva</li>
				</ul>
			</div>
		</div>

		<!-- AMC (21/10/2026): socios de la Asociación de Mobiliario de Cocina. El sello y su
		     reclamo «La buena cocina hecha en casa» van tal cual los manda AMC (brand book),
		     sobre tarjeta blanca porque el pie es naranja. -->
		<div class="mt-12 pt-8 border-t border-orange-300/30 flex justify-center">
			<a href="https://www.amcocina.com/empresas-colaboradoras/" target="_blank" rel="noopener noreferrer"
			   class="flex items-center gap-5 bg-white rounded-xl px-5 py-3 shadow-md hover:shadow-lg transition-shadow duration-200"
			   aria-label="Masmöbel, empresa asociada a AMC, Asociación de Mobiliario de Cocina">
				<img src="/images/amc/amc.png" alt="AMC, Asociación de Mobiliario de Cocina" width="116" height="58" loading="lazy" class="h-12 w-auto" />
				<span class="text-left leading-tight">
					<span class="block text-gray-900 font-semibold text-sm">Empresa asociada a AMC</span>
					<span class="block text-gray-500 text-xs">Asociación de Mobiliario de Cocina</span>
				</span>
				<img src="/images/amc/la-buena-cocina-hecha-en-casa.png" alt="La buena cocina hecha en casa" width="72" height="71" loading="lazy" class="h-14 w-auto rounded" />
			</a>
		</div>

